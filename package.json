{
  "name": "rb-account-portal",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "./dev.sh",
    "build": "next build",
    "vercel-build": "node scripts/run-migrations.mjs && next build",
    "build:render": "DEPLOY_STANDALONE=1 npm run build && node scripts/prepare-standalone.mjs",
    "start:render": "node .next/standalone/start.js",
    "prestart": "node scripts/run-migrations.mjs",
    "start": "next start --port 5174",
    "migrate": "node scripts/run-migrations.mjs",
    "email:preview": "node --experimental-strip-types scripts/send-email-preview.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "google-auth-library": "^10.7.0",
    "iron-session": "^8.0.4",
    "mysql2": "^3.11.5",
    "next": "^15.1.0",
    "nodemailer": "^8.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.7.2"
  }
}
