# Production env — Vercel Hobby (free) or other Node host.
# Set these in Vercel → Project → Settings → Environment Variables.

NODE_ENV=production

# Public URL (email links, Google OAuth redirect)
APP_URL=https://acc.sm650.com

# MySQL via StackCP Remote MySQL Access (required when app runs off Serverbyt)
# StackCP → Web Tools → Remote MySQL Access → host + port
# Allow host % (all) so Vercel build + runtime can connect.
DB_HOST=mysql.gb.stackcp.com
DB_PORT=43653
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Min 32 random characters
SESSION_SECRET=replace-with-a-long-random-production-secret

# Do not set DEV_OTP in production

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sm650rb@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Road Burners <sm650rb@gmail.com>

# Google SSO — add production redirect in Google Cloud Console:
# https://acc.sm650.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
