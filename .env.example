# MySQL (StackCP / hosting panel)
# Local dev via Remote MySQL Access: mysql.gb.stackcp.com + DB_PORT from panel
# On-server (same package): use the Server hostname from MySQL Databases (not localhost)
DB_HOST=mysql.gb.stackcp.com
DB_PORT=43581
DB_NAME=your_database_name
DB_USER=your_database_user
# Quote passwords; escape $ as \$ (Next.js expands $VAR in double-quoted values)
DB_PASSWORD="your_database_password"

# Session cookie encryption (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Set to 1 to skip automatic DB migrations on startup (e.g. CI build without DB)
# SKIP_DB_MIGRATE=1

# Public base URL for email verification links and Google OAuth redirects
APP_URL=http://localhost:5174

# Dev OTP (always accepted; logged to console when SMS is not configured)
DEV_OTP=000000

# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sm650rb@gmail.com
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="Road Burners <sm650rb@gmail.com>"

# Google SSO (OAuth 2.0 Web client — add BOTH authorized redirect URIs in Google Cloud):
#   http://localhost:5174/api/auth/google/callback
#   https://acc.sm650.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
